APP_ENV=development
APP_NAME=Asteria Analyst AI
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/asteria.db
JWT_SECRET_KEY=replace-me-with-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_TEMPERATURE=0.0
LOCAL_ANALYTICS_ENGINE=pandas
DATA_UPLOAD_DIRECTORY=./data/uploads
EXPORT_DIRECTORY=./data/exports
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=csv,xlsx,parquet
MAX_QUERY_ROWS=5000
DEFAULT_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=20
MAX_QUERY_JOINS=5
MAX_AGENT_STEPS=6
FRONTEND_URL=http://localhost:5173

